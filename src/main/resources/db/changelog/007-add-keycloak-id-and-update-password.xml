<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.21.xsd">

    <changeSet id="007-add-keycloak-id" author="kai">
        <addColumn tableName="auth_users">
            <column name="keycloak_id" type="VARCHAR(255)">
                <constraints unique="true"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="007-update-password-nullable" author="kai">
        <dropNotNullConstraint tableName="auth_users" columnName="password" columnDataType="VARCHAR(255)"/>
    </changeSet>

</databaseChangeLog>
